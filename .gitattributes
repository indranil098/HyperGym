# Normalize line endings so Windows and CI agree.
* text=auto eol=lf

# Keep Windows tooling happy.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.keystore binary
*.jar binary
*.apk binary
